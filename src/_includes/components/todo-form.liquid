<div class="flex gap-3 mb-8">
  <input type="text" id="todoInput"
    class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
    placeholder="{{ placeholder }}" autocomplete="off">
  <button id="addBtn"
    class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition transform hover:scale-105 active:scale-95">
    {{ btnText }}
  </button>
</div>
