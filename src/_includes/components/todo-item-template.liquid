<template id="todo-item-template">
  <li class="flex items-center gap-3 p-4 bg-base-200 rounded-box border border-base-300 hover:shadow-sm transition">
    <input type="checkbox" class="checkbox checkbox-primary peer" data-action="toggle">
    <span class="flex-1 peer-checked:line-through peer-checked:text-base-content/50 peer-checked:transition-all"></span>
    <button class="btn btn-error btn-sm"
      data-action="delete">{{ deleteText }}</button>
  </li>
</template>