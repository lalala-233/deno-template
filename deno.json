{
  "version": "0.1.0",
  "tasks": {
    "build": "deno task build:ts && deno task build:css && deno task build:html",
    "build:css": "deno run --allow-env --allow-read --allow-write=dist --allow-ffi --deny-run npm:@tailwindcss/cli -i src/input.css -o dist/output.css --minify --silent",
    "build:html": "deno run --allow-read=dist --allow-write=dist scripts/build.tsx",
    "build:ts": "deno bundle src/main.tsx -o dist/main.js --minify --quiet",
    "check": "deno task check:fmt && deno task check:lint && deno task check:types && deno task check:i18n",
    "check:fmt": "deno fmt --check",
    "check:i18n": "deno run --allow-read=src,dist scripts/check-i18n.ts",
    "check:lint": "deno lint",
    "check:types": "deno check",
    "clean": "deno run --allow-write=dist scripts/clean.ts",
    "clean:no-html": "deno run --allow-write=dist scripts/clean.ts dist/main.js dist/output.css",
    "dev": "deno run --watch=src,scripts --allow-read=dist --allow-run=deno --allow-net=127.0.0.1:3000 scripts/dev.ts"
  },
  "imports": {
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3",
    "daisyui": "npm:daisyui@^5.7.44",
    "html-minifier-terser": "npm:html-minifier-terser@^7.2.0",
    "preact": "npm:preact@^10.29.8",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
